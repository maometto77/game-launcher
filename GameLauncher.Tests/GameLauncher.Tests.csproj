<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Matches the Desktop project's target framework. A test project cannot
      reference a project targeting a higher platform version than its own, and
      UseWPF is required to construct the windows these tests realise.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Test names document themselves; XML comments on every fact would be noise. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameLauncher.Desktop\GameLauncher.Desktop.csproj" />
    <ProjectReference Include="..\GameLauncher.Shared\GameLauncher.Shared.csproj" />
    <ProjectReference Include="..\GameLauncher.Relay\GameLauncher.Relay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

  <!--
    Captured payloads from the real sources. Parsing is tested against what a
    site actually returned rather than against a hand-written approximation of
    it, which is the only way these tests notice a source changing shape.
  -->
  <ItemGroup>
    <None Include="Discovery\Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The example manifests shipped in docs, copied here so a test loads the very
    files a user is told to copy. Documentation that has drifted from the code
    is worse than none, and this is the only way to notice.
  -->
  <ItemGroup>
    <None Include="..\docs\adapter-examples\**\*"
          Link="AdapterExamples\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
