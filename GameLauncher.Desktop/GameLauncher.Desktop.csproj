<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Plain net8.0-windows. The platform version was previously pinned to
      10.0.17763.0 for the Windows toast notification API; that package is gone and
      achievement toasts are drawn in-app instead, so nothing here needs a Windows
      10 build-time API surface. Every native call the launcher makes — icon
      extraction, read-only process memory, the dark title bar — either predates
      Windows 10 or is already best-effort with a documented fallback, so the
      runtime floor is whatever .NET 8 itself supports.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <RootNamespace>GameLauncher.Desktop</RootNamespace>
    <AssemblyName>GameLauncher.Desktop</AssemblyName>
    <Description>Steam-style game launcher desktop client.</Description>

    <!--
      Version stamped into the executable and shown at the foot of the sidebar.
      Kept here rather than in the publish profile so a plain build reports the
      same number a published one does.
    -->
    <Version>1.0.0</Version>
    <Company>GameLauncher</Company>
    <Product>GameLauncher</Product>

    <!--
      Trimming is deliberately OFF, and this is the one production-build setting
      worth explaining rather than just setting.

      WPF is not trim-compatible and Microsoft does not support it: XAML resolves
      types by name at run time, and the linker cannot see those references. A
      trimmed WPF build links, publishes, and then fails when some style, control
      template or converter is first realised — which is to say after shipping,
      on a screen no test opened. The saving is not worth a class of failure that
      only appears in the field.

      Single-file and compression are safe and are enabled in the publish
      profile, where they belong: they change how the output is packaged, not
      what is in it.
    -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameLauncher.Shared\GameLauncher.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Declared explicitly rather than relied upon from ImplicitUsings. WPF's XAML
      markup pass compiles through a generated *_wpftmp project that imports
      System.Windows.Shapes (which also defines a Path type) but not System.IO,
      so file-system code that compiles in the main pass fails in that one. A
      project-level Using flows into both passes and keeps them consistent.
    -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Path-traversal guards and file-name sanitisers are internal because nothing
      outside this assembly should call them, but they are exactly the logic most
      worth testing directly rather than through a UI.
    -->
    <InternalsVisibleTo Include="GameLauncher.Tests" />
  </ItemGroup>

  <!--
    External programs the launcher shells out to, bundled if they are present.

    Drop an executable into tools\win-x64\ and it is copied to tools\ beside the
    published application, where ExternalToolLocator looks before it falls back
    to PATH. Nothing here downloads anything: the folder is empty in the
    repository, the build succeeds without it, and a launcher that silently
    fetched and ran an executable would be doing the most abusable thing a
    desktop application can do.

    Today that means aria2c.exe, which buys multi-connection downloads and
    BitTorrent. Ludusavi is deliberately absent — this launcher reads the
    community manifest directly and never runs the program, so shipping the
    binary would be dead weight.
  -->
  <ItemGroup>
    <None Include="tools\win-x64\**\*" Condition="Exists('tools\win-x64')">
      <Link>tools\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="ReportBundledTools" AfterTargets="Build">
    <ItemGroup>
      <BundledTool Include="tools\win-x64\*" Condition="Exists('tools\win-x64')" />
    </ItemGroup>

    <Message Importance="normal"
             Condition="'@(BundledTool)' != ''"
             Text="Bundling external tools: @(BundledTool->'%(Filename)%(Extension)', ', ')" />

    <!--
      Said once, at normal verbosity, so a release build does not quietly ship
      without the tool someone assumed was in it.
    -->
    <Message Importance="normal"
             Condition="'@(BundledTool)' == '' AND '$(Configuration)' == 'Release'"
             Text="No external tools bundled. aria2c is optional; without it, torrents are unavailable and downloads use the built-in engine. See tools/README.md." />
  </Target>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.7.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
    <PackageReference Include="SharpCompress" Version="0.50.3" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
