<?xml version="1.0" encoding="utf-8"?>
<!--
  Production publish profile for the desktop client.

    dotnet publish GameLauncher.Desktop -c Release -p:PublishProfile=win-x64

  Produces one self-contained Don.exe that runs on a machine
  with no .NET installed.

  Do not publish into a directory that is an ancestor of the source tree. WPF
  builds the XAML markup pass through a generated temporary project, and if the
  output directory contains the source, that pass overwrites the real assembly
  with a stub — a 7 KB "Don.dll" that builds cleanly and will
  not start. Publish to a sibling folder.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\publish\win-x64\</PublishDir>

    <!--
      Self-contained: the runtime ships with the application. A launcher is
      installed by people who want to play a game, not to be told to go and find
      a framework first.
    -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <!--
      Native libraries are bundled into the executable and extracted on first
      run. Without this they sit beside it as loose .dll files, which is not a
      single file in any sense a user would recognise.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!--
      Compression roughly halves the executable at the cost of a slower first
      start, because the bundle is decompressed into a cache directory once. For
      something launched from a desktop shortcut and left running, that is the
      right side of the trade.
    -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!--
      Off. See the note in the csproj: WPF resolves types from XAML by name, the
      linker cannot see those references, and a trimmed build fails when a style
      or template is first realised rather than when it is published.
    -->
    <PublishTrimmed>false</PublishTrimmed>

    <!--
      ReadyToRun costs about 15 MB and buys a noticeably faster cold start, which
      is the first thing anyone judges a launcher on.
    -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--
      Stops the referenced projects' .pdb and .xml files being copied beside the
      executable. Without it the output is a single file plus two loose
      artefacts that exist only to help a debugger, which rather undermines the
      claim. Symbols for the client itself are embedded, above.
    -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>
