<Window x:Class="GameLauncher.Desktop.Views.InstallFromUrlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:GameLauncher.Desktop.ViewModels"
        Title="Install from a link"
        Width="720"
        Height="620"
        MinWidth="620"
        MinHeight="520"
        Background="{StaticResource BackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=viewModels:InstallFromUrlViewModel}"
        FontFamily="{StaticResource UiFontFamily}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d">

    <Window.Resources>
        <DataTemplate x:Key="CandidateTemplate">
            <Grid Margin="8,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="30"
                        Height="30"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        CornerRadius="2">
                    <Image Margin="3" Source="{Binding Icon}" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="{Binding ExecutablePath}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ExecutablePath}" />
                    <TextBlock Foreground="{StaticResource WarningBrush}"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="{Binding Note}"
                               Visibility="{Binding Note, Converter={StaticResource HasValueToVisibility}}" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Style="{StaticResource MutedTextStyle}"
                           Text="{Binding SizeText}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource TitleTextStyle}" Text="Install from a link" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource MutedTextStyle}"
                       Text="Paste a direct link to a file. Archives are unpacked automatically."
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Style="{StaticResource SectionLabelTextStyle}" Text="DOWNLOAD LINK" />
            <TextBox Margin="0,6,0,0"
                     IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBoolean}}"
                     Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,14,0,0" Style="{StaticResource SectionLabelTextStyle}" Text="CHECKSUM (OPTIONAL)" />
            <TextBox Margin="0,6,0,0"
                     IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBoolean}}"
                     Text="{Binding ExpectedChecksum, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="MD5, SHA-1, SHA-256 or SHA-512. The algorithm is inferred from the length." />
        </StackPanel>

        <!-- Progress -->
        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <Grid>
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource MutedTextStyle}"
                           Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button MinWidth="110"
                            Command="{Binding StartCommand}"
                            Content="Download"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />
                    <Button MinWidth="110"
                            Command="{Binding CancelDownloadCommand}"
                            Content="Stop"
                            Style="{StaticResource DangerButtonStyle}"
                            Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </Grid>

            <ProgressBar Margin="0,10,0,0"
                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                         Maximum="1"
                         Value="{Binding ProgressValue}" />

            <Border Margin="0,12,0,0"
                    Padding="12,9"
                    Background="{StaticResource WarningBannerBrush}"
                    BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Visibility="{Binding Warning, Converter={StaticResource HasValueToVisibility}}">
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding Warning}"
                           TextWrapping="Wrap" />
            </Border>

            <Border Margin="0,12,0,0"
                    Padding="12,9"
                    Background="{StaticResource DangerBannerBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Detected executables -->
        <Grid Grid.Row="3"
              Margin="0,18,0,0"
              Visibility="{Binding HasCandidates, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Style="{StaticResource SectionLabelTextStyle}"
                       Text="WHICH EXECUTABLE LAUNCHES THE GAME?" />

            <Border Grid.Row="1"
                    Margin="0,8,0,0"
                    Background="{StaticResource BackgroundDeepBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                <ListBox ItemContainerStyle="{StaticResource RowItemStyle}"
                         ItemTemplate="{StaticResource CandidateTemplate}"
                         ItemsSource="{Binding Candidates}"
                         SelectedItem="{Binding SelectedCandidate}" />
            </Border>

            <TextBlock Grid.Row="2"
                       Margin="0,8,0,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="{Binding InstallDirectory}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <StackPanel Grid.Row="4"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Command="{Binding CancelCommand}"
                    Content="Close"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Margin="10,0,0,0"
                    MinWidth="150"
                    Command="{Binding RegisterCommand}"
                    Content="Add to library"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
