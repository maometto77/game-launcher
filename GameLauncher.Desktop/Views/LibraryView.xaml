<UserControl x:Class="GameLauncher.Desktop.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:GameLauncher.Desktop.Models"
             xmlns:viewModels="clr-namespace:GameLauncher.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:LibraryViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>

        <!--
            Fallback cover art. Games added by picking an executable often have no
            capsule image, so rather than show an empty rectangle the tile draws
            the title's initials over a tinted panel. It stays readable at tile
            size and makes the library scannable before any artwork exists.
        -->
        <DataTemplate x:Key="CoverArtTemplate">
            <Grid Width="150" Height="225">
                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="2">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="52"
                               FontWeight="Light"
                               Foreground="{StaticResource TextDisabledBrush}"
                               Text="{Binding Initials}" />
                </Border>

                <Image Source="{Binding CoverArtPath, Converter={StaticResource PathToImage}}"
                       Stretch="UniformToFill" />

                <!-- Title plate, always visible so the grid is readable without hovering -->
                <Border VerticalAlignment="Bottom" Background="{StaticResource TilePlateBrush}" Padding="8,6">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Title}" />
                </Border>

                <Border Margin="0,6,6,0"
                        Padding="5,2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{StaticResource MissingBadgeBrush}"
                        CornerRadius="2"
                        ToolTip="The executable recorded for this game was not found on disk."
                        Visibility="{Binding IsExecutableMissing, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="MISSING" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Grid mode: a clickable cover tile -->
        <DataTemplate x:Key="GameTileTemplate">
            <Button Margin="6"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <ContentPresenter ContentTemplate="{StaticResource CoverArtTemplate}" Content="{Binding}" />
            </Button>
        </DataTemplate>

        <!-- List mode: a compact row carrying more metadata -->
        <DataTemplate x:Key="GameRowTemplate">
            <Button Margin="0,1"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="2" Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="26"
                            Height="26"
                            HorizontalAlignment="Left"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            CornerRadius="2">
                        <Grid>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding Initials}" />
                            <Image Source="{Binding CoverArtPath, Converter={StaticResource PathToImage}}"
                                   Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Margin="8,0,0,0"
                                    Padding="4,1"
                                    Background="{StaticResource DangerBannerBrush}"
                                    CornerRadius="2"
                                    Visibility="{Binding IsExecutableMissing, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock FontSize="10"
                                           Foreground="{StaticResource DangerHoverBrush}"
                                           Text="missing" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding TagsText}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding TagsText, Converter={StaticResource HasValueToVisibility}}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Style="{StaticResource MutedTextStyle}"
                               Text="{Binding LastPlayedText}" />
                    <TextBlock Grid.Column="3"
                               VerticalAlignment="Center"
                               Style="{StaticResource MutedTextStyle}"
                               Text="{Binding PlaytimeText}" />
                    <TextBlock Grid.Column="4"
                               VerticalAlignment="Center"
                               Style="{StaticResource MutedTextStyle}"
                               Text="{Binding InstallSizeText}" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Grid.Row="0" Margin="28,22,28,0">
            <StackPanel>
                <TextBlock Style="{StaticResource DisplayTextStyle}" Text="Library" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedTextStyle}" Text="{Binding ResultSummary}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button Command="{Binding InstallFromUrlCommand}"
                        Content="Install from link…"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Download and install a game from a direct link" />
                <Button Margin="10,0,0,0"
                        Command="{Binding ScanFolderCommand}"
                        Content="Scan folder…"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Search a folder for games and choose which to add" />
                <Button Margin="10,0,0,0"
                        Command="{Binding AddGameCommand}"
                        Content="Add game"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Add a single game by selecting its executable" />
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="28,18,28,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                <!-- Placeholder, shown only while the box is empty -->
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextDisabledBrush}"
                           IsHitTestVisible="False"
                           Text="Search titles and tags"
                           Visibility="{Binding SearchText, Converter={StaticResource HasValueToVisibility}, ConverterParameter=Invert}" />
            </Grid>

            <ComboBox Grid.Column="1"
                      Width="180"
                      Margin="10,0,0,0"
                      DisplayMemberPath="Label"
                      ItemsSource="{Binding CollectionFilters}"
                      SelectedItem="{Binding SelectedCollectionFilter}" />

            <ComboBox Grid.Column="2"
                      Width="150"
                      Margin="10,0,0,0"
                      ItemsSource="{Binding SortOrders}"
                      SelectedItem="{Binding SortOrder}" />

            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <ToggleButton Command="{Binding SetViewModeCommand}"
                              CommandParameter="{x:Static models:LibraryViewMode.Grid}"
                              Content="Grid"
                              IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Grid}"
                              Style="{StaticResource SegmentToggleStyle}" />
                <ToggleButton Margin="4,0,0,0"
                              Command="{Binding SetViewModeCommand}"
                              CommandParameter="{x:Static models:LibraryViewMode.List}"
                              Content="List"
                              IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=List}"
                              Style="{StaticResource SegmentToggleStyle}" />
            </StackPanel>
        </Grid>

        <!-- Games -->
        <Grid Grid.Row="2" Margin="22,0,22,0">
            <ScrollViewer Padding="0,0,6,16">
                <!--
                    An ItemsControl rather than a virtualising ListBox: selection is
                    not a concept here (each tile is a button), and a personal
                    library is a few hundred rows at most, well inside what a
                    non-virtualised panel handles comfortably.
                -->
                <ItemsControl ItemsSource="{Binding VisibleGames}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemTemplate" Value="{StaticResource GameTileTemplate}" />
                            <Setter Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewMode}" Value="List">
                                    <Setter Property="ItemTemplate" Value="{StaticResource GameRowTemplate}" />
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel Orientation="Vertical" />
                                            </ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource HeadingTextStyle}"
                           Text="Nothing to show" />
                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Add a game, or clear your search and filters." />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
