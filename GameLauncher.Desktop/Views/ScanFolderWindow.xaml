<Window x:Class="GameLauncher.Desktop.Views.ScanFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:GameLauncher.Desktop.ViewModels"
        Title="Scan a folder for games"
        Width="820"
        Height="640"
        MinWidth="700"
        MinHeight="500"
        Background="{StaticResource BackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=viewModels:ScanFolderViewModel}"
        FontFamily="{StaticResource UiFontFamily}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d">

    <Window.Resources>
        <DataTemplate x:Key="ScanResultTemplate">
            <Border Padding="8,7" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsSelected}"
                              IsEnabled="{Binding IsSelectable}" />

                    <Border Grid.Column="1"
                            Width="30"
                            Height="30"
                            Margin="10,0,0,0"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            CornerRadius="2">
                        <Image Margin="3" Source="{Binding Icon}" />
                    </Border>

                    <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding ExecutablePath}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ExecutablePath}" />
                        <TextBlock Foreground="{StaticResource WarningBrush}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding Note}"
                                   Visibility="{Binding Note, Converter={StaticResource HasValueToVisibility}}" />
                    </StackPanel>

                    <TextBlock Grid.Column="3"
                               VerticalAlignment="Center"
                               Style="{StaticResource MutedTextStyle}"
                               Text="{Binding SizeText}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource TitleTextStyle}" Text="Scan a folder for games" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource MutedTextStyle}"
                       Text="Nothing is added until you choose it. Likely games are ticked for you." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Command="{Binding BrowseFolderCommand}"
                    Content="Browse…"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    MinWidth="90"
                    Command="{Binding ScanCommand}"
                    Content="Scan"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    MinWidth="90"
                    Command="{Binding CancelScanCommand}"
                    Content="Stop"
                    Style="{StaticResource DangerButtonStyle}"
                    Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibility}}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource MutedTextStyle}"
                       Text="{Binding StatusText}"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Visibility="{Binding HasScanned, Converter={StaticResource BooleanToVisibility}}">
                <Button Command="{Binding SelectLikelyCommand}" Content="Likely" Style="{StaticResource LinkButtonStyle}" />
                <TextBlock Margin="8,0" Style="{StaticResource MutedTextStyle}" Text="·" />
                <Button Command="{Binding SelectAllCommand}" Content="All" Style="{StaticResource LinkButtonStyle}" />
                <TextBlock Margin="8,0" Style="{StaticResource MutedTextStyle}" Text="·" />
                <Button Command="{Binding SelectNoneCommand}" Content="None" Style="{StaticResource LinkButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Background="{StaticResource BackgroundDeepBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <Grid>
                <ListBox ItemTemplate="{StaticResource ScanResultTemplate}"
                         ItemsSource="{Binding Results}"
                         ItemContainerStyle="{StaticResource RowItemStyle}" />

                <TextBlock Margin="0,40,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Style="{StaticResource MutedTextStyle}"
                           Text="No results yet."
                           Visibility="{Binding HasScanned, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Border Padding="12,9"
                    HorizontalAlignment="Left"
                    Background="{StaticResource DangerBannerBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding ErrorMessage}" />
            </Border>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Command="{Binding CancelCommand}"
                        Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Margin="10,0,0,0"
                        MinWidth="150"
                        Command="{Binding AddSelectedCommand}"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <TextBlock>
                        <Run Text="Add" />
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" />
                        <Run Text="selected" />
                    </TextBlock>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
