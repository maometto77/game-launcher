<UserControl x:Class="GameLauncher.Desktop.Views.GameDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:GameLauncher.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:GameDetailsViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="AchievementRowTemplate">
            <Border Margin="0,0,0,6"
                    Padding="12,10"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--
                        Locked achievements are dimmed rather than hidden, so the
                        page shows what is still available to earn.
                    -->
                    <Border Grid.Column="0"
                            Width="34"
                            Height="34"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            CornerRadius="2"
                            Opacity="{Binding IsUnlocked, Converter={StaticResource BooleanToOpacity}}">
                        <Grid>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="&#x2605;" />
                            <Image Source="{Binding DisplayIconPath, Converter={StaticResource PathToImage}}"
                                   Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                Opacity="{Binding IsUnlocked, Converter={StaticResource BooleanToOpacity}}">
                        <!--
                            Display* rather than the raw definition text, so a
                            hidden achievement's name never reaches the view.
                        -->
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   Text="{Binding DisplayTitle}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding DisplayDescription}"
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,6,0,1" Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ProgressBar Grid.Column="0"
                                         Height="5"
                                         VerticalAlignment="Center"
                                         Maximum="100"
                                         Style="{StaticResource ProgressBarStyle}"
                                         Value="{Binding ProgressPercent, Mode=OneWay}" />
                            <TextBlock Grid.Column="1"
                                       Margin="10,0,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="{Binding ProgressText}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding KindLabel}" />
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding UnlockedText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer>
        <Grid Visibility="{Binding Game, Converter={StaticResource HasValueToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hero banner -->
            <Grid Grid.Row="0" Height="260" ClipToBounds="True">
                <!--
                    Blurred cover art, as a backdrop. Most games here have a
                    portrait cover and no wide banner, which left the hero a flat
                    slab of background; enlarging and blurring the cover fills it
                    with something that belongs to the game without competing
                    with the title over it.

                    Scaled past the edges because a blur samples beyond its own
                    bounds and would otherwise fade to transparent at the sides.
                    Drawn at low quality deliberately — it is about to be blurred,
                    so sampling it carefully would be work thrown away.
                -->
                <Image Source="{Binding Game.CoverArtPath, Converter={StaticResource PathToImage}}"
                       Opacity="0.55"
                       RenderOptions.BitmapScalingMode="LowQuality"
                       RenderTransformOrigin="0.5,0.5"
                       Stretch="UniformToFill">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                    </Image.RenderTransform>
                    <Image.Effect>
                        <BlurEffect KernelType="Gaussian" Radius="60" />
                    </Image.Effect>
                </Image>

                <!-- The real banner, when the game has one, over that backdrop. -->
                <Image Source="{Binding Game.HeroArtPath, Converter={StaticResource PathToImage}}"
                       Stretch="UniformToFill" />
                <!-- Scrim keeps the title legible over arbitrary artwork -->
                <Rectangle Fill="{StaticResource HeroScrimBrush}" />

                <Grid Margin="28,0,28,20" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="110"
                            Height="165"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            CornerRadius="3">
                        <Grid>
                            <!-- Neutral placeholder shown only until real cover art exists -->
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="34"
                                       Foreground="{StaticResource TextDisabledBrush}"
                                       Text="&#x25A2;" />
                            <Image Source="{Binding Game.CoverArtPath, Converter={StaticResource PathToImage}}"
                                   Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="20,0,0,6" VerticalAlignment="Bottom">
                        <TextBlock Style="{StaticResource DisplayTextStyle}"
                                   Text="{Binding Game.Title}"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                            <Button Command="{Binding PlayCommand}"
                                    Content="PLAY"
                                    Style="{StaticResource PlayButtonStyle}" />

                            <TextBlock Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource InGameBrush}"
                                       Text="Running"
                                       Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibility}}" />

                            <TextBlock Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource DangerHoverBrush}"
                                       Text="Executable not found"
                                       Visibility="{Binding IsExecutableMissing, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="28,22,28,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- Left: notes and achievements -->
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Style="{StaticResource SectionLabelTextStyle}" Text="NOTES" />
                    <TextBox Margin="0,8,0,0"
                             Style="{StaticResource MultilineTextBoxStyle}"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Button Command="{Binding SaveNotesCommand}"
                                Content="Save notes"
                                IsEnabled="{Binding HasUnsavedNotes}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="Unsaved changes"
                                   Visibility="{Binding HasUnsavedNotes, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>

                    <Grid Margin="0,26,0,0">
                        <TextBlock Style="{StaticResource SectionLabelTextStyle}" Text="ACHIEVEMENTS" />
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding AchievementSummary}" />
                    </Grid>

                    <ItemsControl Margin="0,10,0,0"
                                  ItemTemplate="{StaticResource AchievementRowTemplate}"
                                  ItemsSource="{Binding AchievementItems}" />

                    <!--
                        Achievements another program recorded, kept in their own
                        section. These are read from a file on disk rather than
                        awarded by this launcher, and showing them among the
                        curated ones would misrepresent where they came from.
                        Absent entirely when nothing has been observed.
                    -->
                    <StackPanel Margin="0,26,0,0"
                                Visibility="{Binding HasExternalAchievements, Converter={StaticResource BooleanToVisibility}}">
                        <Grid>
                            <TextBlock Style="{StaticResource SectionLabelTextStyle}" Text="RECORDED ON THIS PC" />
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="{Binding ExternalAchievementSummary}" />
                        </Grid>

                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding ExternalAchievementItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="14,11"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource SubheadingTextStyle}"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis" />

                                                <TextBlock Margin="0,2,0,0"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Text="{Binding DetailText}"
                                                           TextTrimming="CharacterEllipsis" />

                                                <!-- Only for something measurably part-done. -->
                                                <Grid Margin="0,8,0,0"
                                                      Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibility}}">
                                                    <ProgressBar Height="5"
                                                                 Maximum="100"
                                                                 Minimum="0"
                                                                 Value="{Binding ProgressPercent, Mode=OneWay}" />
                                                </Grid>

                                                <TextBlock Margin="0,4,0,0"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Text="{Binding ProgressText}"
                                                           Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibility}}" />
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Style="{StaticResource BadgeStyle}">
                                                <TextBlock Style="{StaticResource BadgeTextStyle}"
                                                           Text="{Binding StateLabel}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Right: statistics and actions -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelTextStyle}" Text="PLAY TIME" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource TitleTextStyle}"
                                       Text="{Binding PlaytimeText}" />

                            <Separator Margin="0,14" />

                            <Grid>
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Last played" />
                                <TextBlock HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding LastPlayedText}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Sessions" />
                                <TextBlock HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding SessionCountText}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Install size" />
                                <TextBlock HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding InstallSizeText}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelTextStyle}" Text="ARTWORK" />

                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="Search a different title if the match is wrong."
                                       TextWrapping="Wrap" />

                            <TextBox Margin="0,8,0,0"
                                     Text="{Binding ArtworkSearchTitle, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding FindArtworkCommand}"
                                    Content="Find artwork"
                                    Style="{StaticResource SecondaryButtonStyle}" />

                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="{Binding ArtworkStatus}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ArtworkStatus, Converter={StaticResource HasValueToVisibility}}" />

                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource WarningBrush}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="Add a SteamGridDB API key in Settings to enable artwork lookup."
                                       TextWrapping="Wrap"
                                       Visibility="{Binding NeedsArtworkKey, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelTextStyle}" Text="INSTALL" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="{Binding Game.InstallDir}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="{Binding Game.ExecutablePath}"
                                       TextWrapping="Wrap" />

                            <Button Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ChangeExecutableCommand}"
                                    Content="Change executable…"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Point this entry at a different program without losing its playtime or notes." />
                        </StackPanel>
                    </Border>

                    <!--
                        Where progress is kept. Answers a question a person
                        actually has before they reinstall or move a game, and
                        one this launcher is otherwise silent about.
                    -->
                    <Border Margin="0,12,0,0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelTextStyle}" Text="SAVES" />

                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="{Binding SaveStatusText}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding SaveStatusText, Converter={StaticResource HasValueToVisibility}}" />

                            <ItemsControl Margin="0,10,0,0"
                                          ItemsSource="{Binding SaveLocations}"
                                          Visibility="{Binding HasSaveLocations, Converter={StaticResource BooleanToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6"
                                                Padding="10,8"
                                                Background="{StaticResource SurfaceRaisedBrush}"
                                                CornerRadius="6">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <!--
                                                        Presence is stated in words as well as
                                                        colour. A dot alone is unreadable to
                                                        anyone who does not distinguish the two
                                                        hues, and this is a status indicator.
                                                    -->
                                                    <Ellipse Width="7"
                                                             Height="7"
                                                             VerticalAlignment="Center"
                                                             Fill="{StaticResource OfflineBrush}"
                                                             x:Name="Dot" />

                                                    <TextBlock x:Name="Status"
                                                               Margin="7,0,0,0"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Text="{Binding StatusText}" />

                                                    <TextBlock Margin="8,0,0,0"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Text="{Binding KindLabel}" />

                                                    <TextBlock Margin="8,0,0,0"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Text="{Binding TagsText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding HasTags, Converter={StaticResource BooleanToVisibility}}" />
                                                </StackPanel>

                                                <TextBlock Margin="0,4,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Text="{Binding Path}"
                                                           TextWrapping="Wrap"
                                                           ToolTip="{Binding Path}" />
                                            </StackPanel>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Exists}" Value="True">
                                                <Setter TargetName="Dot"
                                                        Property="Fill"
                                                        Value="{StaticResource InGameBrush}" />
                                                <Setter TargetName="Status"
                                                        Property="Foreground"
                                                        Value="{StaticResource InGameBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--
                                Offered rather than done on page load: answering
                                means downloading the save manifest, which is a
                                decision that belongs to the person running this.
                            -->
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding LookUpSavesCommand}"
                                    Content="Look up save locations"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Downloads the community save manifest the first time it is used."
                                    Visibility="{Binding SavesNeedLookup, Converter={StaticResource BooleanToVisibility}}" />

                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="Looking up…"
                                       Visibility="{Binding IsResolvingSaves, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Button Margin="0,12,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding UninstallCommand}"
                            Content="Remove from library"
                            Style="{StaticResource DangerButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
