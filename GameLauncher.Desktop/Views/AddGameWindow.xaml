<Window x:Class="GameLauncher.Desktop.Views.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:GameLauncher.Desktop.ViewModels"
        Title="Add a game"
        Width="620"
        Height="560"
        Background="{StaticResource BackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=viewModels:AddGameViewModel}"
        FontFamily="{StaticResource UiFontFamily}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource TitleTextStyle}" Text="Add a game" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource MutedTextStyle}"
                       Text="Pick the executable you launch the game with. Everything else is filled in from it." />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">

            <TextBlock Style="{StaticResource SectionLabelTextStyle}" Text="EXECUTABLE" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding ExecutablePath, Mode=OneWay}" />
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Command="{Binding BrowseCommand}"
                        Content="Browse…"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>

            <!-- Preview of what was read out of the executable -->
            <Border Margin="0,14,0,0"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{Binding HasExecutable, Converter={StaticResource BooleanToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="52"
                            Height="52"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            CornerRadius="3">
                        <Image Margin="6" Source="{Binding IconPreview}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                   Style="{StaticResource SubheadingTextStyle}"
                                   Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding DetectedSummary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Non-blocking heuristic warning -->
            <Border Margin="0,10,0,0"
                    Padding="12,9"
                    Background="{StaticResource WarningBannerBrush}"
                    BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Visibility="{Binding ValidationWarning, Converter={StaticResource HasValueToVisibility}}">
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding ValidationWarning}"
                           TextWrapping="Wrap" />
            </Border>

            <TextBlock Margin="0,18,0,0" Style="{StaticResource SectionLabelTextStyle}" Text="TITLE" />
            <TextBox Margin="0,6,0,0" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,14,0,0" Style="{StaticResource SectionLabelTextStyle}" Text="INSTALL FOLDER" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding InstallDirectory, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Command="{Binding BrowseInstallDirectoryCommand}"
                        Content="Change…"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource SectionLabelTextStyle}" Text="TAGS" />
                    <TextBox Margin="0,6,0,0"
                             Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Separate tags with commas" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource SectionLabelTextStyle}" Text="COLLECTION" />
                    <ComboBox Margin="0,6,0,0"
                              DisplayMemberPath="Name"
                              ItemsSource="{Binding Collections}"
                              SelectedItem="{Binding SelectedCollection}" />
                </StackPanel>
            </Grid>

            <Border Margin="0,14,0,0"
                    Padding="12,9"
                    Background="{StaticResource DangerBannerBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Command="{Binding CancelCommand}"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Margin="10,0,0,0"
                    MinWidth="110"
                    Command="{Binding AddCommand}"
                    Content="Add game"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
