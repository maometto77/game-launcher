<!--
    The shell: navigation rail on the left, current page on the right.

    Two rendering settings are set here rather than per view, because they have
    to hold everywhere to be worth anything. 'Ideal' text formatting keeps glyph
    positioning correct as the interface scales, and UseLayoutRounding snaps
    element edges to whole device pixels — without it the single-pixel borders
    this design leans on land on half a pixel at 125% and 150% and are drawn as
    two grey ones. Both inherit down the whole tree.
-->
<Window x:Class="GameLauncher.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:GameLauncher.Desktop.Models"
        xmlns:viewModels="clr-namespace:GameLauncher.Desktop.ViewModels"
        xmlns:views="clr-namespace:GameLauncher.Desktop.Views"
        Title="Don"
        Width="1280"
        Height="800"
        MinWidth="940"
        MinHeight="620"
        Background="{StaticResource BackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
        FontFamily="{StaticResource UiFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource ChromeBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16,20,16,18">
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               Style="{StaticResource TitleTextStyle}"
                               Text="Don" />
                    <TextBlock Margin="0,2,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="Local library" />
                </StackPanel>

                <!--
                    Five destinations, each answering a different question: what
                    do I have, what exists, what is transferring, who am I
                    playing with. Pages that answer the same question appear as
                    sub-navigation in the header, not as another row here.
                -->
                <StackPanel Grid.Row="1">
                    <RadioButton Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static models:NavigationSection.Library}"
                                 Content="Library"
                                 GroupName="Sections"
                                 IsChecked="{Binding ActiveSection, Mode=OneWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Library}"
                                 Style="{StaticResource NavItemStyle}" />
                    <RadioButton Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static models:NavigationSection.Search}"
                                 Content="Search catalog"
                                 GroupName="Sections"
                                 IsChecked="{Binding ActiveSection, Mode=OneWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Search}"
                                 Style="{StaticResource NavItemStyle}" />
                    <RadioButton Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static models:NavigationSection.Downloads}"
                                 Content="Downloads"
                                 GroupName="Sections"
                                 IsChecked="{Binding ActiveSection, Mode=OneWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Downloads}"
                                 Style="{StaticResource NavItemStyle}" />
                    <RadioButton Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static models:NavigationSection.Friends}"
                                 Content="Friends"
                                 GroupName="Sections"
                                 IsChecked="{Binding ActiveSection, Mode=OneWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Friends}"
                                 Style="{StaticResource NavItemStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <!-- Settings sits apart from the content sections, at the foot. -->
                    <RadioButton Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static models:NavigationSection.Settings}"
                                 Content="Settings"
                                 GroupName="Sections"
                                 IsChecked="{Binding ActiveSection, Mode=OneWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Settings}"
                                 Style="{StaticResource NavItemStyle}" />

                    <TextBlock Margin="16,10,16,14"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="{Binding Version, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                Header: Back, then the active section's sub-navigation. Both
                live here rather than inside the pages, so the strip stays put
                while the content beneath it changes.
            -->
            <Border Grid.Row="0"
                    Height="52"
                    Background="{StaticResource BackgroundDeepBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            Command="{Binding GoBackCommand}"
                            Content="&#x2190;  Back"
                            Style="{StaticResource LinkButtonStyle}"
                            ToolTip="Return to the previous page"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibility}}" />

                    <!--
                        Hidden when the section has a single page: one tab that
                        cannot be switched away from is decoration, not
                        navigation. The strip keeps its own selection, so
                        returning to a section lands where the user left it.
                    -->
                    <ListBox Grid.Column="1"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             DisplayMemberPath="Label"
                             ItemsSource="{Binding SubSections}"
                             SelectedItem="{Binding SelectedSubSection, Mode=TwoWay}"
                             Style="{StaticResource SubNavStripStyle}"
                             Visibility="{Binding HasSubSections, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>
            </Border>

            <!-- Inline error banner -->
            <Border Grid.Row="1"
                    Background="{StaticResource DangerBannerBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,9"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap" />
            </Border>

            <!--
                Hosts the active page. The DataTemplates in ViewTemplates.xaml
                select the view for whichever view model is current.
            -->
            <ContentControl Grid.Row="2"
                            Content="{Binding CurrentPage}"
                            Focusable="False" />
        </Grid>

        <!--
            Achievement toasts, last so they draw over whichever page is active
            and across the sidebar. Collapsed while there is nothing to announce,
            so the corner it occupies is only unclickable when a toast is up.
        -->
        <views:AchievementToastHost Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    DataContext="{Binding Toasts}" />
    </Grid>
</Window>
