<Application x:Class="GameLauncher.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        No StartupUri: the main window is resolved from the DI container in
        App.OnStartup so that it receives its view model by injection.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Order matters. Each dictionary resolves StaticResource
                    references against the ones merged before it, so the palette
                    must come first and the type ramp before anything that uses
                    it.
                -->
                <!--
                    The palette is swapped wholesale by IThemeService. It must
                    stay first: every dictionary below resolves against its keys.
                -->
                <ResourceDictionary Source="Resources/Theme/Palette.Dark.xaml" />
                <ResourceDictionary Source="Resources/Theme/Typography.xaml" />
                <ResourceDictionary Source="Resources/Theme/Buttons.xaml" />
                <ResourceDictionary Source="Resources/Theme/Inputs.xaml" />
                <ResourceDictionary Source="Resources/Theme/Lists.xaml" />
                <ResourceDictionary Source="Resources/Theme/Cards.xaml" />
                <ResourceDictionary Source="Resources/Converters.xaml" />
                <ResourceDictionary Source="Resources/ViewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
