# Copy to .env beside compose.yml and edit. .env is gitignored; this file is not.

# The domain the relay answers on. Its A/AAAA record must already point at this
# VPS before the first `docker compose up`, because Caddy proves control of the
# name over port 80 to obtain the certificate.
RELAY_DOMAIN=relay.example.com

# Where Let's Encrypt sends expiry warnings. A real address you read.
RELAY_ACME_EMAIL=you@example.com

# Only for a browser client. The desktop launcher is not a browser and needs
# nothing here; leave it empty.
RELAY_ALLOWED_ORIGIN=
