<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Regenerates don.ico from the mark's geometry.

      dotnet run [project] deploy/branding/IconGenerator

    Deliberately NOT in GameLauncher.sln. It runs once when the logo changes and
    has no business in a normal build, a test run, or the published output.

    Uses WPF's own renderer rather than a NuGet imaging package: RenderTargetBitmap
    rasterises with anti-aliasing, PngBitmapEncoder writes the frames, and
    Geometry.Parse understands the same path syntax the SVG uses — so the shield
    is one string copied from don-mark.svg rather than a second drawing that has
    to be kept in step with it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Don.Branding</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
